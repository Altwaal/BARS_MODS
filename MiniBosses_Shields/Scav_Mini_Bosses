-- Health scaling factors
local queenHealthScale = 1.3
local matriarchHealthScale = 1.3
if unitDefs[matriarchBasicName] then
    matriarchHealthScale = unitDefs[matriarchBasicName].health / 60000
end
if unitDefs['raptor_queen_epic'] then
    queenHealthScale = unitDefs['raptor_queen_epic'].health / 1250000
end

-- Player count scaling
local playerCountScale = 1
if spring.Utilities.Gametype.IsRaptors() then 
    playerCountScale = (#spring.GetTeamList() - 2) / 12 
end

-- Spawn count multiplier from mod options
local spawnCountMult = spring.GetModOptions().raptor_spawncountmult or 3
playerCountScale = playerCountScale * (spawnCountMult / 3)

-- Helper function to scale spawn counts
local function scaleSpawnCount(baseCount)
    return math.max(1, math.ceil(baseCount * playerCountScale))
end

-- Anger level thresholds for boss spawning (similar to mini bosses)
local angerThresholds = {01, 85, 90, 105, 110, 125}

-- Queen time multiplier affects anger scaling
local queenTimeMult = math.max(1, spring.GetModOptions().raptor_queentimemult or 1.3)
local minAnger, maxAnger = angerThresholds[1], angerThresholds[#angerThresholds]
local scaledMaxAnger = queenTimeMult * angerThresholds[#angerThresholds] / 1.3
local angerScale = (scaledMaxAnger - minAnger) / (maxAnger - minAnger)

-- Scale all anger thresholds based on queen time multiplier
for i = 2, #angerThresholds do 
    angerThresholds[i] = math.floor(minAnger + (angerThresholds[i] - minAnger) * angerScale)
end

-- Helper function to create unit variants by copying and merging properties
