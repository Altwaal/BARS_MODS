-- Store original UnitDef_Post function if it exists
local originalUnitDefPost = UnitDef_Post

-- Override UnitDef_Post to apply metal cost scaling
function UnitDef_Post(unitDefName, unitDefTable)
    -- Call original function if it exists
    if originalUnitDefPost then 
        originalUnitDefPost(unitDefName, unitDefTable) 
    end
    
    -- Apply health-based cost scaling (minimal for testing)
    local costScale = 1
    if matriarchHealthScale > 1.3 then 
        costScale = matriarchHealthScale / 1.3 
    end
    
    -- Apply scaled metal costs to boss units
    for unitName, baseCost in pairs(metalCosts) do
        if unitDefs[unitName] then
            local scaledCost = math.floor(baseCost * costScale)
            unitDefs[unitName].metalcost = scaledCost
        end
    end
end
